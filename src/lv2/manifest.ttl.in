@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

# Gerado pelo CMake a partir de src/lv2/manifest.ttl.in: o nome da lib e a CLASSE
# da UI sao por sistema (o host decide pelo tipo o handle que manda na create()),
# e sem UI construida o ultimo paragrafo nao existe. Editar src/lv2/manifest.ttl.in.

<https://pianoforge.audio/plugin>
    a lv2:Plugin ;
    lv2:minorVersion @PFORGE_MINOR@ ;
    lv2:microVersion @PFORGE_MICRO@ ;
    lv2:binary <@PFORGE_BINARY@> ;
    rdfs:seeAlso <pianoforge.ttl>@PFORGE_UI_REF@ .
@PFORGE_UI_BLOCK@
