# build
build/
build-*/
out/
dist/
cmake_install.cmake
CMakeCache.txt
CMakeFiles/
compile_commands.json

# sfizz e outras dependências baixadas por script (nunca vendorizadas aqui)
third_party/sfizz/
third_party/vst3sdk/
third_party/*/build/
.deps/

# artefatos de teste: render, captura, bundle montado localmente
*.wav
*.ppm
*.log
*.vst3/
packaging/fixture/out*/
packaging/fixture/*.pforge
!packaging/fixture/test.pforge
!packaging/fixture/bad.pforge

# área de trabalho local (toolchain portátil, builds de auditoria, capturas de
# trabalho): nada aqui é fonte nem entra em pacote
_tmp/

# capturas de trabalho na raiz; o PNG que vale é docs/images/pianoforge-painel.png
/painel*.png
/*_status.png
/*.ppm_*

# som e bancos de trabalho do usuário — o repo não distribui soundfont
*.sf2
*.sf3
*.sfz
*.aiff
*.aif
*.flac
*.ogg

# o fixture do bundle é um SF2 sintético de 27 bytes gerado pelo empacotador,
# não um banco: ele precisa estar no repo para o teste H rodar em CI
!packaging/fixture/bank.sf2

# editor / SO
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
